# colliderml-production scripts/cli/env_setup.yaml for quirk samples (written by quirkml's
# colliderml/setup.sh). Tracker-only stages in the sw:pr-8 sim image; no calorimeter or
# Pandora stages. Based on the two-container env_setup.yaml used for the ColliderML productions.
env_variables:
  # In-container environment assembler, read from this checkout (podman-hpc mounts m4958 CFS
  # and $PSCRATCH at the same paths inside the container).
  CONTAINER_SETUP: "@COLLIDERML@/scripts/cli/setup_container_env.sh"
  ACTS_ARROW_SETUP: "/opt/acts-arrow/setup.sh"
  ODD_THIS_SCRIPT: "/opt/odd-install/bin/this_odd.sh"

config_defaults:
  common:
    account: m4958
    container: "ghcr.io/opendatadetector/sw:pr-8"
    # Your own run tree. The colliderml-production default is the public production tree.
    output_base_dir: "@RUNS_BASE@"
    public_output_base_dir: "@RUNS_BASE@/public"

simulation:
  - 'source {CONTAINER_SETUP}'
  - '[ -f {ACTS_ARROW_SETUP} ] && source {ACTS_ARROW_SETUP} || true'
  - '[ -f {ODD_THIS_SCRIPT} ] && source {ODD_THIS_SCRIPT} || true'

postprocessing:
  - 'source {CONTAINER_SETUP}'
